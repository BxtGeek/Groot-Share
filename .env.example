# Groot Share environment variables
# Copy this file to .env and adjust as needed.

# Application
APP_NAME=Groot Share
APP_TAGLINE="Your files. Your shares. Your control."
APP_HOST=0.0.0.0
APP_PORT=8080

# Configuration file location (inside container)
CONFIG_PATH=/config/storages.json

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=2048

# Administrator password (change this!)
ADMIN_PASSWORD=admin

# Secret key for session cookies (change this!)
SESSION_SECRET=change-me-in-production

# Allowed container mount roots (colon-separated)
PERMITTED_ROOTS=/storage

# Session cookie security
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Rate limiting for login attempts
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_SECONDS=300

# Host port mapping for Docker Compose (default: 80)
HOST_PORT=80